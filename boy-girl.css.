
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    font-family: Arial, sans-serif;
    background: #f8f5ef;
    color: #493b32;
}

.cover {
    min-height: 100vh;
    display: flex;
    justify-content: center;
    align-items: center;
    text-align: center;
    padding: 30px 20px;
    background: linear-gradient(145deg, #f8f3eb, #e8d9c8);
}

.cover-content {
    border: 1px solid rgba(255,255,255,.8);
    outline: 1px solid rgba(255,255,255,.5);
    outline-offset: 10px;
    padding: 65px 35px;
    width: 100%;
    max-width: 480px;
}

.small-title {
    font-size: 11px;
    letter-spacing: 4px;
    margin-bottom: 30px;
}

.cover h1 {
    font-family: Georgia, serif;
    font-size: clamp(48px, 10vw, 75px);
    font-weight: normal;
    line-height: 1.2;
}

.ampersand {
    font-family: Georgia, serif;
    font-size: 35px;
    margin: 10px 0;
    color: #9b8068;
}

.cover p {
    line-height: 1.8;
    font-size: 13px;
}

.primary-button {
    display: inline-block;
    margin-top: 30px;
    padding: 15px 28px;
    background: #493b32;
    color: white;
    text-decoration: none;
    font-size: 11px;
    letter-spacing: 2px;
    border: none;
    cursor: pointer;
}

section {
    padding: 90px 22px;
    text-align: center;
}

.section-label {
    font-size: 10px;
    letter-spacing: 4px;
    color: #9b8068;
    margin-bottom: 20px;
}

h2 {
    font-family: Georgia, serif;
    font-size: clamp(30px, 6vw, 45px);
    font-weight: normal;
    margin-bottom: 25px;
}

.intro {
    max-width: 570px;
    margin: auto;
    line-height: 1.9;
    font-size: 14px;
}

.couple-section {
    background: #fffdf9;
}

.couple-names {
    font-family: Georgia, serif;
    font-size: 35px;
    line-height: 1.6;
}

.event-card {
    max-width: 650px;
    margin: 35px auto 0;
    padding: 35px 20px;
    background: #fffdf9;
    border: 1px solid #e7ddd0;
    line-height: 2;
}

.event-card h3 {
    font-family: Georgia, serif;
    font-size: 25px;
    font-weight: normal;
    margin-bottom: 15px;
}

.countdown {
    display: flex;
    justify-content: center;
    gap: 15px;
    flex-wrap: wrap;
    margin-top: 35px;
}

.time-box {
    min-width: 75px;
    padding: 18px 10px;
    background: #fffdf9;
    border: 1px solid #e7ddd0;
}

.time-box strong {
    display: block;
    font-family: Georgia, serif;
    font-size: 25px;
}

.time-box span {
    font-size: 9px;
    letter-spacing: 1px;
}

.gallery {
    background: #fffdf9;
}

.gallery-placeholder {
    max-width: 550px;
    height: 350px;
    margin: 30px auto 0;
    display: flex;
    justify-content: center;
    align-items: center;
    background: linear-gradient(145deg, #eee4d8, #d8c5b0);
    color: white;
    font-family: Georgia, serif;
    font-size: 24px;
}

.rsvp {
    background: #eee5da;
}

.rsvp input,
.rsvp select {
    width: 100%;
    max-width: 400px;
    padding: 15px;
    margin: 8px auto;
    display: block;
    border: 1px solid #d7c8b7;
    background: #fffdf9;
    font-size: 14px;
}

.rsvp button {
    margin-top: 15px;
}

footer {
    padding: 35px 20px;
    text-align: center;
    font-size: 11px;
    letter-spacing: 2px;
    background: #493b32;
    color: white;
}

@media (max-width: 600px) {
    section {
        padding: 70px 20px;
    }

    .cover-content {
        padding: 55px 20px;
    }

    .gallery-placeholder {
        height: 280px;
    }
}
